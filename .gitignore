# private per-builder standalone builds (regenerate with JU_STANDALONE=... node src/build.js)
.build/
# raw capture frames stay local; contact sheets (sheet.png), state screenshots and logs are committed
evidence/**/review-*/**/f[0-9]*.png
evidence/**/fix-r*/**/f[0-9]*.png
evidence/**/verify-r*/**/f[0-9]*.png
# settings R2: raw capture frames stay local; sheets, named state screenshots and logs are committed
settings-r2/evidence/**/f[0-9]*.png
settings-r2/evidence/**/f[0-9]*.jpg
settings-r2/evidence/**/s[0-9][0-9].png
settings-r2/evidence/*.tmp
