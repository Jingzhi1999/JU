{
  "name": "ju-rituals",
  "version": 1,
  "note": "共享票根仪式包的打包清单。单文件交付时由构建按 scripts 顺序一次性内联；运行时不再 fetch assets/original/*.js 或 assets/fonts/fonts.css。stamp.js 只在 window 全局缺失时才按需注入原件脚本，打包后不会触发。CSS 只按家族名引用字体，字体由构建随共享包内联（data: URL 或 blob）。",
  "css": ["ticket.css", "print.css", "tear.css", "burn.css", "stamp.css"],
  "scripts": [
    { "path": "print.js", "global": "JURitual.print", "embeds": "assets/original/v27/ju-print.js", "provides": "JuPrint" },
    { "path": "tear.js", "global": "JURitual.tear", "embeds": "assets/original/v27/ju-tear.js", "provides": "JUTear" },
    { "path": "burn.js", "global": "JURitual.burn", "embeds": "assets/original/v27/ju-nativeburn.js", "provides": "JUNativeBurn" },
    { "path": "contact.js", "global": "JURitual.contact" },
    { "path": "assets/original/v27/ju-paper-film.js", "provides": "JuFilm", "verbatim": true },
    { "path": "assets/original/v27/ju-envelope.js", "provides": "JuEnvelope", "verbatim": true },
    { "path": "assets/original/v27/ju-stamp.js", "provides": "JuStamp", "verbatim": true },
    { "path": "assets/original/v27/ju-tickets2.js", "provides": "JuTickets", "verbatim": true },
    { "path": "stamp.js", "global": "JURitual.stamp / JURitual.stampFace", "requires": ["JuFilm", "JuEnvelope", "JuStamp", "JuTickets"], "shims": "JuLedger（页面无 V27 账本时）" }
  ],
  "optional": [
    { "path": "assets/original/r9/ju-tickets-host.js", "provides": "JuTicketsHost", "when": "JURitual.stamp(..., {adapter:'r9'})", "note": "R9 局主端适配器（未认可变体），默认不打包" }
  ],
  "archive_only": ["assets/original/v27/ju-burn.js"],
  "fonts": {
    "source": "assets/fonts/fonts.css",
    "families": ["Noto Sans SC", "Space Mono", "Archivo", "Noto Serif SC", "Libre Caslon Text", "Caveat", "Zhi Mang Xing", "Archivo Black", "Oswald"],
    "note": "ticket.css / stamp.css 只用家族名；构建把 fonts.css 的 @font-face（含 unicode-range 切片）与 woff2 内联进共享包；demo.html / ticket.html 直接 <link> fonts.css 仅供离线演示"
  },
  "dom_hooks": ["data-print-stage", "data-paper", "data-paper-shadow", "data-paper-shell", "data-paper-surface", "data-tear", "data-burn", "data-raster", "data-wet", "data-bend", "data-slot", "data-t08-scope", "data-t08"],
  "demo_only": ["demo.html", "ticket.html"]
}
